APP_NAME=DreamBigHealth Market Access Intelligence
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://market_access:local_dev_password@localhost:5433/dreambighealth

RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
EXPORT_DIR=data/exports

LOG_LEVEL=INFO

ANVISA_SOURCE_URL=https://dados.anvisa.gov.br/dados/DADOS_ABERTOS_MEDICAMENTOS.csv

CONITEC_SOURCE_URL=https://s3.sa-east-1.amazonaws.com/ckan.saude.gov.br/CONITEC/csv/Controle_de_Demandas_da_Conitec.csv.zip

CONNECTOR_TIMEOUT_SECONDS=120
CONNECTOR_BATCH_SIZE=1000

CONITEC_DASHBOARD_SOURCE_URL=https://www.gov.br/conitec/pt-br/midias/dados-em-excel/painel_demandas_conitec_20261026.xlsx/@@download/file
